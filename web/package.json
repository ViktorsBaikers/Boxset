		"sv": "1.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"valibot": "1.5.0",
		"vite": "8.1.6",
		"vitest": "5.0.3",
