{
	"name": "boxset-web",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun --bun vite build && bun scripts/precompress.ts",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --threshold warning --fail-on-warnings && bun --bun eslint --max-warnings 0 . && bun --bun prettier --check .",
